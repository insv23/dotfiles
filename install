#!/usr/bin/env bash

set -e

CONFIG="config.yaml"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

if ! command -v dotdrop >/dev/null 2>&1; then
  echo "错误：未找到 dotdrop，先安装：brew install dotdrop" >&2
  exit 1
fi

# 干净环境要补一个文件，避免 zsh 打印登录提示
touch ~/.hushlogin

# 插件不在这里装：清单与用途记录在 herdr/plugins.md，换设备时按那份文件手动装。

# dotdrop 按主机名取默认 profile，仓库只有一个 default，显式指定避免新主机上静默不安装
# -f 跳过交互确认：dfu 等无 TTY 场景下，input() 会直接 EOF 报错；backup: true 仍保留 .dotdropbak
DOTDROP_PROFILE=default dotdrop --cfg "${CONFIG}" install -f "${@}"