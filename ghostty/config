# 主题：Ghostty 内置 Catppuccin Mocha
theme = Catppuccin Mocha

# 与 kitty 对齐的字体设置
# kitty 使用的是 Maple Mono NF CN 全套字族
font-family = Maple Mono NF CN
font-family-bold = Maple Mono NF CN
font-family-italic = Maple Mono NF CN
font-family-bold-italic = Maple Mono NF CN
font-size = 14

# 保持和 kitty 一致的 OpenType 字形特性
font-feature = cv01
font-feature = ss02
font-feature = ss04
font-feature = ss05
font-feature = zero

# Ghostty / cmux 与 kitty 的渲染引擎不同
# 开启轻微字重增强，让中文和整体观感更接近 kitty
font-thicken = true
font-thicken-strength = 48

# 给终端内容留一点边距，左侧稍大一些，贴边感会轻很多
window-padding-x = 8,4
window-padding-y = 6

# 把无法整除字符网格的零头像素均匀分配到四边
window-padding-balance = true

# padding 区域沿用边缘单元格背景色，视觉上更连贯
window-padding-color = extend

# split-divider-color / unfocused-split-opacity / unfocused-split-fill
# 这三个 Ghostty 配置目前在 cmux 里不生效，是已知 bug（issue #1400 / #1658）
# 官方还未修复，待 cmux 修复后再启用

# 将 Option 键作为 Meta/Alt，以支持 alt+p 等快捷键
macos-option-as-alt = true

# 光标形状改为竖杠（bar），替代默认的 block（box）
cursor-style = bar

# 隐藏标题栏：去掉标题栏但保留圆角和窗口边框
macos-titlebar-style = hidden

# ----- 快捷键 -----
# ctrl+tab / ctrl+shift+tab 交给 herdr 遍历 tab。Ghostty 1.3.1 默认把这两个键绑成
# 自己的 next_tab / previous_tab，按键在 Ghostty 这层就被吃掉，herdr 收不到。
# 用 csi: 直接送出 herdr 能解析的 kitty 键盘协议序列，不依赖两端是否协商过键盘协议：
# 9;5u = Ctrl+Tab，9;6u = Ctrl+Shift+Tab（modifiers = 1 + shift(1) + ctrl(4)）。
keybind = ctrl+tab=csi:9;5u
keybind = ctrl+shift+tab=csi:9;6u
# Ghostty 自己的 tab 切换仍有 super+shift+[ / super+shift+]（默认未改动）。
# 改完必须手动重载：Ghostty 不监听配置文件，改 keybind 后按 cmd+shift+, 触发
# reload_config，或重启 App；否则运行中的实例一直用旧键位。
